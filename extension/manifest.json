{
  "manifest_version": 3,
  "name": "Veil Browser Agent",
  "version": "1.0",
  "description": "Privacy-aware browser agent",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}